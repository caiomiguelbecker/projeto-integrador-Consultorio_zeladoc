# ============================================================
# ZelaDoc - Exemplo de configuração do banco de dados
# 1. Copie este arquivo e renomeie a cópia para: .env
# 2. Preencha com os dados do SEU MySQL
# (o arquivo .env não vai para o GitHub, pois contém senha)
# ============================================================

# Endereço do servidor MySQL (normalmente localhost)
DB_HOST=localhost

# Usuário do MySQL
DB_USER=root

# Senha do seu MySQL
DB_PASSWORD=sua_senha_aqui

# Nome do banco (criado pelo script zeladoc_banco.sql)
DB_NAME=zeladoc
